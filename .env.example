# Пароль для входа. Если пусто — вход без пароля (только для локального использования!)
HEALTH_PASSWORD=

# Порт сервера
PORT=3001

# Папка, где лежат база health.db и загруженные файлы (uploads/). По умолчанию ./data
# DATA_DIR=/var/lib/health

# Поставь 1, если сайт открывается по https (обязательно на хостинге)
SECURE_COOKIE=0

# Только для сервера с docker-compose: домен, на который выпустить HTTPS-сертификат
# DOMAIN=health.example.ru
